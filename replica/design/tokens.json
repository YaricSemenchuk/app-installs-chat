{
  "_about": "Light theme + shared scales. Identity: Promobile design system (promobile-ads/src/styles/generated, sandbox/tokens). Names are roles; values may change, names stay. Dark colours live in tokens.dark.json. Check every change: python3 ~/.claude/skills/replica-design/contrast.py replica/design/tokens.json (and tokens.dark.json).",
  "_deviations_from_promobile": {
    "text-muted": "#636674 instead of #9698a3 (2.87:1 on white, fails AA); same grey family",
    "accent-hover": "#3553f0 (darker) instead of #5c77ff (lighter): white on #5c77ff is 3.79:1",
    "link": "#3550e0 for text links and mention chips: #4262ff is 4.40:1 on the grey sidebar and hover rows",
    "danger": "#d92d20 / #c4271b instead of #f04438 (3.76:1 with white text)",
    "success": "#0e9655 dot / #067647 text instead of #12b76a (2.62:1 on white)",
    "border-input": "#80838f instead of #d7d9e0 so the composer and inputs reach 3:1"
  },
