  "layout": {
    "titlebar": 44,
    "sidebar": {"default": 264, "min": 200, "max": 400},
    "header": 52,
    "thread-panel": {"default": 400, "min": 320, "max": 600},
    "message-gutter": 20,
    "composer-min": 44,
    "modal": {"s": 440, "m": 560, "l": 720},
    "breakpoints": {"narrow": 768, "medium": 1024, "wide": 1280},
    "_note": "No measurements of Slack: these are our own values for a dense work chat. One sidebar (no separate tab rail); titlebar doubles as the Electron drag region and holds search."
