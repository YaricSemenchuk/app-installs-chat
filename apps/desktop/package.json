{
  "name": "appinstallschat",
  "version": "1.1.0",
  "private": true,
  "description": "Чат команды AppInstalls: сообщения, звонки и уведомления на компьютере",
  "author": "AppInstalls",
  "homepage": "https://github.com/YaricSemenchuk/app-installs-chat",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "build": "tsc -p tsconfig.json && node scripts/write-config.mjs",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "app.appinstalls.chat",
    "productName": "AppInstalls Chat",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "protocols": [
      {
        "name": "AppInstalls Chat",
        "schemes": [
          "teamchat"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Микрофон нужен для голосовых звонков в AppInstalls Chat.",
        "NSCameraUsageDescription": "Камера нужна для видеозвонков в AppInstalls Chat."
      }
    },
    "dmg": {
      "title": "AppInstalls Chat ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "AppInstalls Chat"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Network",
      "executableName": "appinstallschat",
      "synopsis": "Чат команды AppInstalls",
      "maintainer": "AppInstalls",
      "desktop": {
        "entry": {
          "StartupWMClass": "AppInstalls Chat"
        }
      }
    },
    "artifactName": "appinstallschat-${version}-${os}.${ext}"
  }
}
