  dm_key                                  String?                @unique
  topic                                   String                 @default("")
  topic_set_by                            String?                @db.Uuid
  topic_set_at                            DateTime?              @db.Timestamptz(6)
  purpose                                 String                 @default("")
  is_general                              Boolean                @unique(map: "conversations_one_general", where: raw("is_general")) @default(false)
  is_default                              Boolean                @default(false)
  posting_policy                          String                 @default("everyone")
  allow_channel_mentions                  Boolean                @default(true)
  created_by                              String                 @db.Uuid
  archived_at                             DateTime?              @db.Timestamptz(6)
  archived_by                             String?                @db.Uuid
  created_at                              DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime               @default(now()) @db.Timestamptz(6)
  activity_items                          activity_items[]
  bookmarks                               bookmarks[]
  conversation_members                    conversation_members[]
  users_conversations_archived_byTousers  users?                 @relation("conversations_archived_byTousers", fields: [archived_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users_conversations_created_byTousers   users                  @relation("conversations_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  users_conversations_topic_set_byTousers users?                 @relation("conversations_topic_set_byTousers", fields: [topic_set_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  drafts                                  drafts[]
  messages                                messages[]
  pins                                    pins[]
  scheduled_messages                      scheduled_messages[]

  @@index([archived_by], map: "conversations_archived_by")
  @@index([created_by], map: "conversations_created_by")
  @@index([kind], map: "conversations_kind")
  @@index([name(ops: raw("gin_trgm_ops"))], map: "conversations_name_trgm", type: Gin, where: raw("(kind = ANY (ARRAY['public'::text, 'private'::text]))"))
  @@index([topic_set_by], map: "conversations_topic_set_by")
}

