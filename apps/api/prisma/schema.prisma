generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model activity_items {
  id                                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                              String         @db.Uuid
  kind                                 String
  conversation_id                      String?        @db.Uuid
  message_id                           String?        @db.Uuid
  actor_id                             String?        @db.Uuid
  emoji                                String?
  reminder_id                          String?        @db.Uuid
  read_at                              DateTime?      @db.Timestamptz(6)
  cleared_at                           DateTime?      @db.Timestamptz(6)
  created_at                           DateTime       @default(now()) @db.Timestamptz(6)
  users_activity_items_actor_idTousers users?         @relation("activity_items_actor_idTousers", fields: [actor_id], references: [id], onUpdate: NoAction)
  conversations                        conversations? @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages                             messages?      @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_activity_items_user_idTousers  users          @relation("activity_items_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, kind, message_id], map: "activity_items_once_per_message", where: raw("(kind = ANY (ARRAY['mention'::text, 'thread_reply'::text, 'dm'::text]))"))
  @@unique([user_id, message_id, actor_id, emoji], map: "activity_items_once_per_reaction", where: raw("(kind = 'reaction'::text)"))
  @@index([actor_id], map: "activity_items_actor_id")
  @@index([conversation_id], map: "activity_items_conversation_id")
  @@index([message_id], map: "activity_items_message_id")
  @@index([user_id, created_at(sort: Desc)], map: "activity_items_user_created")
  @@index([user_id], map: "activity_items_user_unread", where: raw("((read_at IS NULL) AND (cleared_at IS NULL))"))
}

model auth_handoffs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  code_hash   Bytes     @unique
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "auth_handoffs_expires_at")
  @@index([user_id], map: "auth_handoffs_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
