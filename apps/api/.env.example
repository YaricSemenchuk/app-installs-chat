# Локальная разработка: скопируйте в apps/api/.env
DATABASE_URL=postgresql://localhost:5432/teamchat_dev
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# Секрет для хэшей кодов входа: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Первый владелец рабочего пространства создаётся при старте
BOOTSTRAP_OWNER_EMAIL=owner@example.com
WORKSPACE_NAME=Promobile
# Домены, с которых можно войти без приглашения (через запятую)
ALLOWED_EMAIL_DOMAINS=example.com

# Без ключа в development письма пишутся в apps/api/.dev-mail.log
RESEND_API_KEY=
EMAIL_FROM=Team chat <chat@example.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Задачи из Jira (только чтение): адрес сайта, почта служебного аккаунта и его API-токен. Пусто — интеграция выключена.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Макеты Figma: персональный токен с правами file_content:read и file_comments:read
FIGMA_TOKEN=

# Файлы: disk (по умолчанию, каталог STORAGE_DIR) для разработки или s3 для бакета (в production — только s3).
STORAGE_DRIVER=disk
STORAGE_DIR=.storage
# BUCKET_ENDPOINT=https://...
# BUCKET_NAME=
# BUCKET_ACCESS_KEY_ID=
# BUCKET_SECRET_ACCESS_KEY=
# BUCKET_REGION=auto
# BUCKET_FORCE_PATH_STYLE=false
